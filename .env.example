# Copy this file to .env and set strong private values.
# The app currently reads environment variables from the process environment.
SURESIGHT_SECRET_KEY=replace-with-a-long-random-secret
SURESIGHT_ADMIN_USERNAME=admin
SURESIGHT_ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Optional: SURESIGHT_DB=/absolute/path/to/suresight.db
